APP_ENV=production
DATABASE_URL=postgresql+psycopg://tutor:tutor@postgres:5432/adaptive_tutor
REDIS_URL=redis://redis:6379/0
DOCUMENT_PROCESSING_MODE=celery
DOCUMENT_PROCESSING_MAX_ATTEMPTS=3
DOCUMENT_PROCESSING_RETRY_DELAY_SECONDS=60
DOCUMENT_OUTBOX_DISPATCH_INTERVAL_SECONDS=15
DOCUMENT_OUTBOX_DISPATCH_LEASE_SECONDS=300
DOCUMENT_MAX_UPLOAD_BYTES=20971520
DOCUMENT_MAX_REQUEST_BYTES=28027564
DOCUMENT_MAX_PDF_PAGES=200
DOCUMENT_MAX_IMAGE_PIXELS=40000000
DOCUMENT_MAX_EXTRACTED_CHARS=2000000
DOCUMENT_MAX_CHUNKS=2000
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=adaptive-tutor-documents
DOCUMENT_OBJECT_STORAGE_BACKEND=minio
OCR_BACKEND=tesseract
TESSERACT_LANG=eng+chi_sim
RAG_RETRIEVAL_BACKEND=pgvector
EMBEDDING_BACKEND=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
OFFICIAL_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_MAX_RETRIES=1
READINESS_PROBE_TIMEOUT_SECONDS=2
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
