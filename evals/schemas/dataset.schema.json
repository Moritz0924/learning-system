{
  "$defs": {
    "EvaluationConversationMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "EvaluationConversationMessage",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "document_id",
        "text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "FormatContract": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "free_text",
            "explanation_with_citations",
            "step_by_step",
            "comparison",
            "insufficient_evidence",
            "strict_json"
          ],
          "title": "Type",
          "type": "string"
        },
        "required_sections": {
          "items": {
            "type": "string"
          },
          "title": "Required Sections",
          "type": "array"
        },
        "required_json_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Json Schema"
        },
        "max_bullets": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Bullets"
        },
        "require_citations": {
          "default": false,
          "title": "Require Citations",
          "type": "boolean"
        },
        "forbidden_fields": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Fields",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "FormatContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "development",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "category": {
      "enum": [
        "single_source",
        "paraphrase",
        "multi_evidence",
        "unanswerable",
        "prompt_injection",
        "multi_turn"
      ],
      "title": "Category",
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "conversation_history": {
      "items": {
        "$ref": "#/$defs/EvaluationConversationMessage"
      },
      "title": "Conversation History",
      "type": "array"
    },
    "gold_answer_points": {
      "items": {
        "type": "string"
      },
      "title": "Gold Answer Points",
      "type": "array"
    },
    "gold_document_ids": {
      "items": {
        "type": "string"
      },
      "title": "Gold Document Ids",
      "type": "array"
    },
    "gold_evidence_spans": {
      "items": {
        "$ref": "#/$defs/EvidenceSpan"
      },
      "title": "Gold Evidence Spans",
      "type": "array"
    },
    "acceptable_alternative_document_ids": {
      "items": {
        "type": "string"
      },
      "title": "Acceptable Alternative Document Ids",
      "type": "array"
    },
    "is_answerable": {
      "title": "Is Answerable",
      "type": "boolean"
    },
    "expected_behavior": {
      "enum": [
        "answer_with_citation",
        "abstain"
      ],
      "title": "Expected Behavior",
      "type": "string"
    },
    "format_contract": {
      "$ref": "#/$defs/FormatContract"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "dataset_version",
    "split",
    "category",
    "difficulty",
    "question",
    "is_answerable",
    "expected_behavior",
    "format_contract"
  ],
  "title": "LearningQaEvaluationCase",
  "type": "object"
}
